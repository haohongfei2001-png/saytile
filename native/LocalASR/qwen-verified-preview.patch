+    // Only token IDs survive a preview. The prompt, audio embedding and full
+    // causal KV cache above are rebuilt from this invocation's PCM.
+    private static func verifyPreviewTokens(
+        textDecoder: QuantizedTextModel, logits initialLogits: MLXArray,
+        cache initialCache: [(MLXArray, MLXArray)], draft: [Int32],
+        maxTokens: Int, check: () throws -> Void
+    ) rethrows -> (tokens: [Int32], accepted: Int) {
+        let eos = Int32(Qwen3ASRTokens.eosTokenId)
+        let end = min(maxTokens, draft.firstIndex(of: eos) ?? draft.count)
+        var accepted = 0
+        var cache = initialCache
+        var logits = initialLogits
+        while end - accepted >= 3 {
+            try check()
+            let first = argMax(logits, axis: -1).squeezed().asType(.int32).item(Int32.self)
+            guard first == draft[accepted] else { break }
+            let count = min(16, end - accepted)
+            let ids = Array(draft[accepted..<(accepted + count)])
+            let embeds = textDecoder.embedTokens(MLXArray(ids).expandedDimensions(axis: 0))
+            let (states, trialCache) = textDecoder(inputsEmbeds: embeds, cache: cache)
+            let scores = textDecoder.embedTokens.asLinear(states)
+            let picks = argMax(scores, axis: -1).asType(.int32).asArray(Int32.self)
+            var matched = 1
+            while matched < count && picks[matched - 1] == ids[matched] { matched += 1 }
+            let prefixLength = cache[0].0.dim(2) + matched
+            if matched == count {
+                cache = trialCache
+            } else {
+                cache = trialCache.map { keys, values in
+                    (keys[0..., 0..., 0..<prefixLength, 0...], values[0..., 0..., 0..<prefixLength, 0...])
+                }
+            }
+            logits = scores[0..., (matched - 1)..<matched, 0...]
+            accepted += matched
+            if matched < count { break }
+        }
+        let tail = try generateGreedyAsyncEval(textDecoder: textDecoder, initialLogits: logits, cache: cache,
+                                               maxTokens: maxTokens - accepted, checkCancellation: check)
+        return (Array(draft.prefix(accepted)) + tail, accepted)
+    }
