     // Only token IDs survive a preview. The prompt, audio embedding and full
     // causal KV cache above are rebuilt from this invocation's PCM.
+    private static func groupedScalar(
+        textDecoder: QuantizedTextModel, logits: MLXArray, initialCache: [(MLXArray, MLXArray)],
+        maxTokens: Int, check: () throws -> Void
+    ) rethrows -> [Int32] {
+        let eos = Int32(Qwen3ASRTokens.eosTokenId)
+        var token = argMax(logits, axis: -1).squeezed().asType(.int32)
+        var cache = initialCache
+        var tokens: [Int32] = []
+        while tokens.count < maxTokens {
+            try check()
+            let count = min(4, maxTokens - tokens.count)
+            var block: [MLXArray] = []
+            for i in 0..<count {
+                block.append(token)
+                if i == count - 1 && tokens.count + count == maxTokens { break }
+                let embed = textDecoder.embedTokens(token.expandedDimensions(axis: 0).expandedDimensions(axis: 0))
+                let (hidden, next) = textDecoder(inputsEmbeds: embed, cache: cache)
+                cache = next
+                let scores = textDecoder.embedTokens.asLinear(hidden[0..., (-1)..., .ellipsis])
+                token = argMax(scores, axis: -1).squeezed().asType(.int32)
+            }
+            let words = stacked(block).asType(.int32)
+            asyncEval(words, token, cache)
+            for item in words.asArray(Int32.self) {
+                tokens.append(item)
+                if item == eos { return tokens }
+            }
+        }
+        return tokens
+    }
