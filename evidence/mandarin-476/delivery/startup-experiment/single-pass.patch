+
+    /// Apply both ASR components in one pass through each shard. Each
+    /// component still sees lexicographically sorted shards and its original
+    /// exact prefix. No tensor dictionary survives into the next shard.
+    public static func loadASRWeights(
+        into audioEncoder: Qwen3AudioEncoder,
+        textDecoder: QuantizedTextModel?,
+        from directory: URL
+    ) throws {
+        let files = try safetensorFiles(in: directory)
+        print("Found \(files.count) safetensor files")
+        var audioApplied = 0
+        var textApplied = 0
+        for file in files {
+            print("Loading: \(file.lastPathComponent)")
+            let raw = try loadSafetensors(url: file)
+            let audioWeights = stripPrefix(raw, prefix: "audio_tower.")
+            if !audioWeights.isEmpty {
+                applyAudioEncoderComponents(
+                    to: audioEncoder, weights: audioWeights,
+                    transposeConv2dPyTorch: false)
+                audioApplied += audioWeights.count
+            }
+            if let textDecoder {
+                let textWeights = stripPrefix(raw, prefix: "model.")
+                if !textWeights.isEmpty {
+                    applyQuantizedTextDecoderComponents(to: textDecoder, weights: textWeights)
+                    textApplied += textWeights.count
+                }
+            }
+        }
+        print("Applied weights to audio encoder (\(audioEncoder.layers.count) layers, \(audioApplied) tensors)")
+        if let textDecoder {
+            print("Applied weights to text decoder (\(textDecoder.layers.count) layers, \(textApplied) tensors)")
+        }
     }
 
