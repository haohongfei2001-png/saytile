+    // Encoder CNN units span 100 mel frames. The bidirectional transformer
+    // has a hard mask every eight such units; only that complete block can be shared.
+    private func previewEncoder(_ mel: MLXArray, normalized: [Float]) -> MLXArray {
+        let frames = mel.dim(2), blockFrames = 800, bins = 128
+        let count = frames / blockFrames, tokens = 104
+        guard count > 0, frames <= 3200, normalized.count == frames * bins else {
+            clearPreviewBlocks()
+            return audioEncoder(mel)
+        }
+        let stride = blockFrames * bins * MemoryLayout<Float>.stride
+        var reuse = 0
+        normalized.withUnsafeBytes { bytes in
+            while reuse < min(count, encodedBlocks.count) {
+                let begin = bytes.baseAddress!.advanced(by: reuse * stride)
+                let identical = encodedBlocks[reuse].mel.withUnsafeBytes { cached in
+                    memcmp(begin, cached.baseAddress!, stride) == 0
+                }
+                guard identical else { break }
+                reuse += 1
+            }
+        }
+        reusedBlocks += reuse
+        encodedBlocks.removeSubrange(reuse..<encodedBlocks.count)
+        let begin = reuse * blockFrames
+        var pieces = encodedBlocks.map(\.embedding)
+        if begin < frames {
+            let encoded = begin == 0 ? audioEncoder(mel) : audioEncoder(mel[0..., 0..., begin..<frames])
+            pieces.append(encoded)
+            for index in reuse..<count {
+                let tokenStart = (index - reuse) * tokens
+                let embedding = encoded[tokenStart..<(tokenStart + tokens), 0...]
+                let source = normalized.withUnsafeBytes { bytes in
+                    Data(bytes: bytes.baseAddress!.advanced(by: index * stride), count: stride)
+                }
+                encodedBlocks.append((source, embedding))
+            }
+        }
+        return pieces.count == 1 ? pieces[0] : concatenated(pieces, axis: 0)
+    }
