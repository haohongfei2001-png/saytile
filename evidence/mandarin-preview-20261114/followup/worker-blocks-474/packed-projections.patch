 import MLXFast
 import AudioCommon
 
+// Fold independent quantized output rows together without dequantization.
+private struct PackedRows {
+    let weight: MLXArray
+    let scales: MLXArray
+    let biases: MLXArray?
+    let ends: [Int]
+    let reference: QuantizedLinear
+
+    init(_ layers: [QuantizedLinear]) {
+        self.reference = layers[0]
+        weight = concatenated(layers.map(\.weight), axis: 0)
+        scales = concatenated(layers.map(\.scales), axis: 0)
+        let zeroPoints = layers.compactMap(\.biases)
+        biases = zeroPoints.isEmpty ? nil : concatenated(zeroPoints, axis: 0)
+        var offset = 0
+        ends = layers.dropLast().map { offset += $0.weight.dim(0); return offset }
+        eval([weight, scales] + (biases.map { [$0] } ?? []))
+        // Retain the original projections as views into the same allocation.
+        let ws = weight.split(indices: ends, axis: 0), ss = scales.split(indices: ends, axis: 0)
+        let bs = biases?.split(indices: ends, axis: 0)
+        for i in layers.indices {
+            var parameters: [(String, MLXArray)] = [("weight", ws[i]), ("scales", ss[i])]
+            if let bs { parameters.append(("biases", bs[i])) }
+            layers[i].update(parameters: .unflattened(parameters))
+        }
+    }
+
+    func project(_ x: MLXArray) -> [MLXArray] {
+        let y = quantizedMM(x, weight, scales: scales, biases: biases, transpose: true,
+                            groupSize: reference.groupSize, bits: reference.bits, mode: reference.mode)
+        return y.split(indices: ends, axis: -1)
+    }
+}
