+// One shared graph across layers. Pass every weight explicitly so a cached
+// compiled function never retains another layer's parameters or a prior model.
+private let fixedPreviewFeedForward: @Sendable ([MLXArray]) -> [MLXArray] = MLX.compile { a in
+    let residual = a[0] + a[1]
+    let x = MLXFast.rmsNorm(residual, weight: a[2], eps: 1e-6)
+    let gate = quantizedMM(x, a[3], scales: a[4], biases: a[5], transpose: true, groupSize: 64, bits: 4)
+    let up = quantizedMM(x, a[6], scales: a[7], biases: a[8], transpose: true, groupSize: 64, bits: 4)
+    let gated = (gate * sigmoid(gate)) * up
+    let down = quantizedMM(gated, a[9], scales: a[10], biases: a[11], transpose: true, groupSize: 64, bits: 4)
+    return [residual + down]
+}
