  "samples": [
    {
      "id": "fleurs-zh-13737992583400421680",
      "reference": "虚拟支持内化在软件中，用来质疑、提示和解释那些可能对学生来说难以独自处理的程序。",
      "critical": [],
      "audio_sha256": "2c130c47ae74549ca6b33e06a547e2165e14f665380d29cefe6667fa5602fe47",
      "duration_s": 10.2,
      "onset_s": 2.14,
      "eos_s": 10.2051,
      "events": [
        {
          "t": 10.2838,
          "frames": 163200,
          "kind": "final",
          "text": "虚拟支持内化在软件中用来质疑提示和解释那些可能对学生来说难以独自处理的程序"
        }
      ]
    },
    {
      "id": "fleurs-zh-15084084705355118496",
      "reference": "写博客是一种能够激发合作的工具，还能鼓励学生把学习延伸到传统的学校授课之外。",
      "critical": [],
      "audio_sha256": "30dcc5a54f9af7aaad1ada8c75d55bbf63d64e94ddeef1dda126cf2db0c3e121",
      "duration_s": 9.66,
      "onset_s": 1.66,
      "eos_s": 9.6628,
      "events": [
        {
          "t": 9.7149,
          "frames": 154560,
          "kind": "final",
          "text": "写博客是一种能够激发合作的工具还能鼓励学生把学习延伸到传统的学校授课之外"
        }
      ]
    },
    {
      "id": "fleurs-zh-16549419822262830660",
      "reference": "罗斯贝数越小，恒星在磁场倒转方面就越不活跃。",
      "critical": [],
      "audio_sha256": "f436221ca14ee130377ae88c5749f530a9b89dc0939b86c0988d3757eca9a2c8",
      "duration_s": 4.86,
      "onset_s": 0.58,
      "eos_s": 4.8627,
      "events": [
        {
          "t": 4.9178,
          "frames": 77760,
          "kind": "final",
          "text": "楼丝倍数越小恒星在磁场倒赚方面就越不活跃"
        }
      ]
    },
    {
      "id": "fleurs-zh-870219628413797707",
      "reference": "它指出，对主体来说最有效的位置是将图像垂直和水平分为三部分的线的交叉点（见示例）。",
      "critical": [],
      "audio_sha256": "42d602b47b9725caa65a9887a857ac3c04293f3ac2b22be5fdc26ccf2ad29c3b",
      "duration_s": 14.18,
      "onset_s": 3.04,
      "eos_s": 14.1832,
      "events": [
        {
          "t": 14.2336,
          "frames": 226880,
          "kind": "final",
          "text": "他指出对主体来说最有效的位置是将图像垂直和水平分成三部分的线的交叉点见实例"
        }
      ]
    },
    {
      "id": "fleurs-zh-2361100735374204762",
      "reference": "恶劣天气是任何危险天气现象的总称；这种天气会造成破坏、严重社会混乱或人员伤亡。",
      "critical": [],
      "audio_sha256": "c431c477ddf936a457213324d3043e62a7f1cc477ff1393bbd627e85820d076a",
      "duration_s": 11.58,
      "onset_s": 1.56,
      "eos_s": 11.5838,
      "events": [
        {
          "t": 11.6136,
          "frames": 185280,
          "kind": "final",
          "text": "恶劣天气是任何危险天气现象的总称这种天气会造成破坏严重社会混乱或人员伤亡"
        }
      ]
    },
    {
      "id": "fleurs-zh-4719524538529342597",
      "reference": "29 岁的 Malar Balasubramanian 医生在俄亥俄州辛辛那提市以北约 15 英里的郊区布鲁艾施被发现，她被找到时身穿 T 恤衫和内裤，躺在路边的地上，看上去服用了大量药物。",
      "critical": [],
      "audio_sha256": "4d9cd95d4f1d39d0330394058adc231ab5a725c6004b731670c2cfdd420113e5",
      "duration_s": 16.68,
      "onset_s": 0.82,
      "eos_s": 16.685,
      "events": [
        {
          "t": 16.7882,
          "frames": 266880,
          "kind": "final",
          "text": "二十九岁的 mar拉巴拉ramian医生在俄亥俄州新星大提市以北约十五公里的郊区布鲁艾斯被发现他被找到时身穿 t 恤衫和内裤躺在路边的地上看上去服用了大量的药物"
        }
      ]
    },
    {
      "id": "fleurs-zh-10056338555786085046",
      "reference": "科学家们可以得出结论，暗物质对其他暗物质的影响方式与普通物质相同。",
      "critical": [
        {
          "text": "暗物质",
          "type": "term",
          "accepted_forms": [
            "暗物质"
          ]
        }
      ],
      "audio_sha256": "e98bd3a78fa3eb617164375180940917a8c8a87ce90b0dbffbfff156a009bf17",
      "duration_s": 12.9,
      "onset_s": 2.66,
      "eos_s": 12.9028,
      "events": [
        {
          "t": 12.9515,
          "frames": 206400,
          "kind": "final",
          "text": "科学作家们可以得出结论暗物质对其他暗物质的影响方式与普通物质相同"
        }
      ]
    },
    {
      "id": "fleurs-zh-11355960588560603456",
      "reference": "氢离子是失去了电子的质子（因为氢原子由一个质子和一个电子组成）。",
